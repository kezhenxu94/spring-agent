{
  "schema": "2.0",
  "config": {
    "update_multi": true,
    "streaming_mode": true,
    "streaming_config": {
      "print_step": {
        "default": 1
      },
      "print_frequency_ms": {
        "default": 50
      },
      "print_strategy": "fast"
    },
    "style": {
      "text_size": {
        "normal_v2": {
          "default": "normal"
        }
      }
    }
  },
  "body": {
    "direction": "vertical",
    "vertical_spacing": "8px",
    "padding": "14px 16px 12px 16px",
    "elements": [
      {
        "tag": "markdown",
        "content": "<font color='grey'>{generating}</font>",
        "text_align": "left",
        "text_size": "normal_v2",
        "element_id": "message"
      },
      {
        "tag": "markdown",
        "content": "",
        "text_align": "left",
        "text_size": "normal_v2",
        "element_id": "todo"
      },
      {
        "tag": "button",
        "text": {
          "tag": "plain_text",
          "content": "{stop}"
        },
        "type": "danger_filled",
        "width": "default",
        "size": "tiny",
        "icon": {
          "tag": "standard_icon",
          "token": "w1-h1_outlined"
        },
        "behaviors": [
          {
            "type": "callback",
            "value": {
              "button": "stop"
            }
          }
        ],
        "element_id": "stop"
      },
      {
        "tag": "hr",
        "margin": "6px 0px 2px 0px",
        "element_id": "guide_divider"
      },
      {
        "tag": "markdown",
        "content": "",
        "text_align": "left",
        "text_size": "notation",
        "margin": "0px",
        "element_id": "usage"
      },
      {
        "tag": "markdown",
        "content": "<font color='grey'>{conversationHint}</font>",
        "text_align": "left",
        "text_size": "notation",
        "margin": "-4px 0px 0px 0px",
        "element_id": "guide"
      }
    ]
  }
}
