{
  "schema": "2.0",
  "config": {
    "update_multi": true,
    "streaming_mode": true,
    "streaming_config": {
      "print_step": {
        "default": 100
      },
      "print_frequency_ms": {
        "default": 50
      },
      "print_strategy": "fast"
    },
    "style": {
      "text_size": {
        "normal_v2": {
          "default": "normal"
        }
      }
    }
  },
  "body": {
    "direction": "vertical",
    "vertical_spacing": "4px",
    "padding": "8px 12px",
    "elements": [
      {
        "tag": "markdown",
        "content": "<font color='grey'>{conversationHint}</font>",
        "text_align": "left",
        "text_size": "notation",
        "element_id": "guide"
      }
    ]
  }
}
